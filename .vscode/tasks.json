{
  // Build tasks for the devcontainer. Each task asks which core to use (see "inputs" at the
  // end: add new cores there). Each build produces same_<core>_libretro.dll / .so in the
  // repository root (the two Linux builds write the same .so name: build one at a time).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Windows x86_64",
      "type": "shell",
      // CC/CXX/AR go in the environment, not as make arguments: arguments would also reach
      // the build of genie (MAME's project generator, a Linux tool) and make it use MinGW.
      "command": "CC=x86_64-w64-mingw32-gcc CXX=x86_64-w64-mingw32-g++ AR=x86_64-w64-mingw32-gcc-ar make -f Makefile.libretro platform=win64 SAME_CORE=${input:core} MINGW64=/usr -j$(nproc)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Linux x86_64",
      "type": "shell",
      "command": "make -f Makefile.libretro platform=unix SAME_CORE=${input:core} -j$(nproc)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      // Cross compile with Ubuntu's aarch64-linux-gnu toolchain (glibc 2.39).
      "label": "Build Linux aarch64",
      "type": "shell",
      // PLATFORM, LIBRETRO_CPU, CROSS_BUILD and ARCHITECTURE are MAME options:
      // - LIBRETRO_CPU would otherwise be the container's CPU (x86_64).
      // - An empty ARCHITECTURE builds MAME's "linux" target instead of "linux_x64",
      //   whose -m64 option aarch64 gcc rejects (MAME's webOS block does the same).
      // - Its own BUILDDIR keeps the aarch64 objects apart from the x86_64 ones.
      "command": "CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ AR=aarch64-linux-gnu-gcc-ar make -f Makefile.libretro platform=unix SAME_CORE=${input:core} PLATFORM=arm64 LIBRETRO_CPU=arm64 CROSS_BUILD=1 ARCHITECTURE= BUILDDIR=build/same_${input:core}-aarch64 -j$(nproc)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Check Windows DLL",
      "type": "shell",
      "command": "f=same_${input:core}_libretro.dll && file $f && x86_64-w64-mingw32-objdump -p $f | grep 'DLL Name' && x86_64-w64-mingw32-objdump -p $f | grep -oE 'retro_[a-z_]+' | sort -u",
      "problemMatcher": []
    },
    {
      "label": "Check Linux x86_64 .so",
      "type": "shell",
      "command": "f=same_${input:core}_libretro.so && file $f && ldd $f && nm -D --defined-only $f | grep -oE 'retro_[a-z_]+' | sort -u && objdump -T $f | grep -oE 'GLIBC_[0-9.]+' | sort -uV | tail -1",
      "problemMatcher": []
    },
    {
      "label": "Check Linux aarch64 .so",
      "type": "shell",
      "command": "f=same_${input:core}_libretro.so && file $f && aarch64-linux-gnu-readelf -d $f | grep NEEDED && aarch64-linux-gnu-nm -D --defined-only $f | grep -oE 'retro_[a-z_]+' | sort -u && aarch64-linux-gnu-objdump -T $f | grep -oE 'GLIBC_[0-9.]+' | sort -uV | tail -1",
      "problemMatcher": []
    },
    {
      // Deletes the core's objects for every platform: its next build starts from scratch.
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build/same_${input:core} build/same_${input:core}-aarch64 same_${input:core}_libretro.dll same_${input:core}_libretro.so",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      // Cores supported by Makefile.libretro (SAME_CORE) and same_cores.h.
      "id": "core",
      "type": "pickString",
      "description": "Core (SAME_CORE)",
      "options": ["a7800", "pv1000"]
    }
  ]
}
